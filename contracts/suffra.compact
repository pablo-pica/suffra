pragma language_version >= 0.23;

import CompactStandardLibrary;

// Suffra privacy model:
// - PUBLIC ledger state: registered voter commitments, used nullifiers, sealed ballot commitments,
//   registration count, sealed ballot count, and voting status.
// - PRIVATE inputs: voter secret, vote choice, and ballot salt.
// - Deliberate disclosure: only commitments and nullifiers are written to public state. The vote
//   choice is committed with fresh salt so observers cannot recover it from a low-domain guess.
// - This is a sealed-ballot MVP: it proves eligibility and one-ballot-per-registered-secret without
//   exposing each ballot choice. Public tally reveal is intentionally not implemented here because
//   per-transaction tally deltas would reveal individual choices.

export ledger votingOpen: Boolean;
export ledger registeredVoters: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger sealedBallots: Set<Bytes<32>>;
export ledger registeredCount: Counter;
export ledger ballotCount: Counter;

constructor() {
  votingOpen = true;
}

export circuit registerVoter(voterSecret: Bytes<32>): [] {
  const commitment = voterCommitment(voterSecret);

  assert(!registeredVoters.member(commitment), "Voter secret is already registered");

  registeredVoters.insert(disclose(commitment));
  registeredCount.increment(1);
}

export circuit castVote(choice: Field, voterSecret: Bytes<32>, ballotSalt: Bytes<32>): [] {
  assert(votingOpen, "Voting is closed");
  assert(choice == 0 || choice == 1, "Choice must be 0 for Against or 1 for For");

  const commitment = voterCommitment(voterSecret);
  assert(registeredVoters.member(commitment), "Voter is not registered");

  const nul = voteNullifier(voterSecret);
  assert(!usedNullifiers.member(nul), "Voter has already cast a ballot");

  const sealedBallot = ballotCommitment(choice, ballotSalt);
  usedNullifiers.insert(disclose(nul));
  sealedBallots.insert(disclose(sealedBallot));
  ballotCount.increment(1);
}

export circuit closeVoting(): [] {
  votingOpen = false;
}

circuit voterCommitment(voterSecret: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "suffra:voter:"), voterSecret]));
}

circuit voteNullifier(voterSecret: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "suffra:nullifier:"), voterSecret]));
}

circuit ballotCommitment(choice: Field, ballotSalt: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "suffra:ballot:"),
    choice as Bytes<32>,
    ballotSalt,
  ]));
}
