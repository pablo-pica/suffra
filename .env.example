# Environment Variables — Suffra
# Copy this file to .env and fill in the deployed contract address.
# NEVER commit .env — only .env.example.

# Network read by src/config/network.ts. Level 4 deploys to Preprod.
VITE_MIDNIGHT_NETWORK=preprod

# Contract address read by src/hooks/useMidnight.ts.
# Required after deploying contracts/suffra.compact.
VITE_SUFFRA_CONTRACT_ADDRESS=

# Optional: browser proofs default to http://127.0.0.1:6300. For privacy,
# only a local loopback HTTP(S) proof-server URL is accepted.
# VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Optional: feedback form URL read by src/config/feedback.ts.
# Must be an HTTPS Google Forms URL (forms.gle or docs.google.com/forms).
# Reusable-form timestamp approach: the same form is reused across Level 5 and Level 6,
# separated by recorded timestamp cutoffs. Deployment configuration is human-owned.
# VITE_FEEDBACK_FORM_URL=https://forms.gle/QSgaRPbEE1W6UJST9
